# Firebase-Web-Konfiguration (Firebase-Konsole > Projekteinstellungen > Meine Apps).
# Kopiere diese Datei nach .env und trage die Werte ein. Die .env-Datei wird nicht eingecheckt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
